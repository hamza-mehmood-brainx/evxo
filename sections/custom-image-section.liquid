<div class="responsive-image-section">
  {% if section.settings.desktop_image %}
    <img
      class="responsive-image desktop-image"
      src="{{ section.settings.desktop_image | img_url: 'master' }}"
      alt="Desktop Image"
      loading="lazy"
    >
  {% endif %}

  {% if section.settings.mobile_image %}
    <img
      class="responsive-image mobile-image"
      src="{{ section.settings.mobile_image | img_url: 'master' }}"
      alt="Mobile Image"
      loading="lazy"
    >
  {% endif %}
</div>

<style>
  .responsive-image {
    width: 100%;
    height: auto;
    display: none;
  }

  @media (min-width: 768px) {
    .responsive-image.desktop-image {
      display: block;
    }
  }

  @media (max-width: 767px) {
    .responsive-image.mobile-image {
      display: block;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Image Section",
  "tag": "section",
  "class": "responsive-image-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    }
  ],
  "presets": [
    {
      "name": "Responsive Image"
    }
  ]
}
{% endschema %}
