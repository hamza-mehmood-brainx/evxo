{% doc %}
  @prompt
    Generate a block which will show latest 3 blog posts cards.
    Each blog post card will consisit of a feature image then title and excerpt and read more button at bottom.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
      @font-face {
        font-family: 'Source Sans Pro';
        font-style: normal;
        font-display: swap;
        font-weight: 600;
        src: url(https://cdn.jsdelivr.net/fontsource/fonts/source-sans-pro@latest/latin-600-normal.woff2) format('woff2'), url(https://cdn.jsdelivr.net/fontsource/fonts/source-sans-pro@latest/latin-600-normal.woff) format('woff');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
       }
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap");
      .blogs .shopify-block{
         width: 100%
       }
       .ai-blog-posts-{{ ai_gen_id }} {
         padding: {{ block.settings.section_padding }}px 0;
       }

       .ai-blog-posts__container-{{ ai_gen_id }} {
         margin: 0 auto;
         padding: 0 20px;
       }

       .ai-blog-posts__heading-{{ ai_gen_id }} {
         text-align: {{ block.settings.heading_alignment }};
         margin-bottom: {{ block.settings.heading_margin }}px;
         color: {{ block.settings.heading_color }};
         font-size: {{ block.settings.heading_size }}px;
       }

       .ai-blog-posts__grid-{{ ai_gen_id }} {
         display: grid;
         grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
         gap: {{ block.settings.card_spacing }}px;
       }

       .ai-blog-post-card-{{ ai_gen_id }} {
         background-color: {{ block.settings.card_background }};
         border-radius: {{ block.settings.card_border_radius }}px;
         overflow: hidden;
         transition: transform 0.3s ease, box-shadow 0.3s ease;display: flex;
         flex-direction: column;
         height: 100%;
         max-width: 390px;
         padding: 15px
       }

       .ai-blog-post-card-{{ ai_gen_id }}:hover {
         transform: translateY(-4px);
         box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
       }

       .ai-blog-post-card__image-wrapper-{{ ai_gen_id }} {
         position: relative;
         width: 100%;
         height: {{ block.settings.image_height }}px;
         overflow: hidden;
         border-radius: 12px
       }

       .ai-blog-post-card__image-{{ ai_gen_id }} {
         width: 100%;
         height: 100%;
         object-fit: cover;
         transition: transform 0.3s ease;
       }

       .ai-blog-post-card-{{ ai_gen_id }}:hover .ai-blog-post-card__image-{{ ai_gen_id }} {
         transform: scale(1.05);
       }

       .ai-blog-post-card__image-placeholder-{{ ai_gen_id }} {
         width: 100%;
         height: 100%;
         background-color: #f4f4f4;
         display: flex;
         align-items: center;
         justify-content: center;
       }

       .ai-blog-post-card__image-placeholder-{{ ai_gen_id }} svg {
         width: 60px;
         height: 60px;
         opacity: 0.5;
       }

       .ai-blog-post-card__content-{{ ai_gen_id }} {
         padding: {{ block.settings.card_padding }}px;
         display: flex;
         flex-direction: column;
         flex-grow: 1;
       }

       .play-btn{
        display: flex;
        background-color: #FFF9E7;
        padding: 5px 12px;
        max-width: 126px;
       font-family: 'Source Sans Pro';
       align-items: center;
       justify-content: space-between;
       font-size: 15px;
       text-transform: uppercase;
       border-radius: 41px;
       margin: 10px 0px;
       pointer: cursor;
       }

       .play-btn .play-btn-txt{
        color: #093F3F;
       }

       .ai-blog-post-card__title-{{ ai_gen_id }} {
         color: {{ block.settings.title_color }};
         font-size: {{ block.settings.title_size }}px;
         font-weight: 600;
         margin: 0 0 12px 0;
         line-height: 1.3;
              font-family: "Montserrat", sans-serif;
           font-weight: 700;
       }

       .ai-blog-post-card__title-link-{{ ai_gen_id }} {
         color: inherit;
         text-decoration: none;
       }

       .ai-blog-post-card__title-link-{{ ai_gen_id }}:hover {
         color: {{ block.settings.link_hover_color }};
       }

       .ai-blog-post-card__excerpt-{{ ai_gen_id }} {
         color: {{ block.settings.excerpt_color }};
         font-size: {{ block.settings.excerpt_size }}px;
         line-height: 1.5;
         margin: 0 0 20px 0;
         flex-grow: 1;
          font-family: "Montserrat", sans-serif;
           font-weight: 400;
       }

       .ai-blog-post-card__meta-{{ ai_gen_id }} {
         color: {{ block.settings.meta_color }};
         font-size: {{ block.settings.meta_size }}px;
         margin-bottom: 16px;
       }

       .ai-blog-post-card__button-{{ ai_gen_id }} {
         display: inline-block;
         background-color: {{ block.settings.button_background }};
         color: {{ block.settings.button_text_color }};
         text-decoration: none;
         border-radius: {{ block.settings.button_border_radius }}px;
         font-size: {{ block.settings.button_text_size }}px;

         text-align: center;
         transition: background-color 0.3s ease, color 0.3s ease;
         align-self: flex-start;
           font-family: "Montserrat", sans-serif;
           font-weight: 600;
           text-transform: uppercase;
       }
        .ai-blog-post-card__button-{{ ai_gen_id }}::after {
    content: "";
    display: inline-block;
    width: 1.2em;
    height: 1.2em;
    margin-left: 0.5em;
    background-image: url('https://cdn.shopify.com/s/files/1/0758/7649/9669/files/Vector_190.svg?v=1754480906');
    vertical-align: middle;
    background-repeat: no-repeat;
  }


       .ai-blog-post-card__button-{{ ai_gen_id }}:hover {
         background-color: {{ block.settings.button_hover_background }};
         color: {{ block.settings.button_hover_text_color }};
       }

       @media screen and (max-width: 768px) {
         .ai-blog-posts__grid-{{ ai_gen_id }} {
           grid-template-columns: 1fr;
           gap: {{ block.settings.card_spacing | times: 0.75 }}px;
         }

         .ai-blog-post-card__image-wrapper-{{ ai_gen_id }} {
           height: {{ block.settings.image_height | times: 0.8 }}px;
         }

         .ai-blog-posts__container-{{ ai_gen_id }} {
           padding: 0 16px;
         }
       }
{% endstyle %}
<div class="ai-blog-posts-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-posts__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-blog-posts__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.blog != blank %}
      <div class="ai-blog-posts__grid-{{ ai_gen_id }}">
        {% for article in block.settings.blog.articles limit: 3 %}
          <article class="ai-blog-post-card-{{ ai_gen_id }}">
            <div class="ai-blog-post-card__image-wrapper-{{ ai_gen_id }}">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.image.alt | escape }}"
                  class="ai-blog-post-card__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ block.settings.image_height }}"
                >
              {% else %}
                <div class="ai-blog-post-card__image-placeholder-{{ ai_gen_id }}">
                  {{ 'blog-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-blog-post-card__content-{{ ai_gen_id }}">
              {% if block.settings.show_date %}
                <div class="ai-blog-post-card__meta-{{ ai_gen_id }}">
                  {{ article.published_at | date: '%B %d, %Y' }}
                </div>
              {% endif %}
              {% if block.settings.show_play_btn %}
                <div class="play-btn">
                  <a href="{{ article.url }}" class="play-btn-txt">Play Listen</a>
                  {{- 'play-icon.svg' | inline_asset_content -}}
                </div>
              {% endif %}
              <h3 class="ai-blog-post-card__title-{{ ai_gen_id }}">
                <a href="{{ article.url }}" class="ai-blog-post-card__title-link-{{ ai_gen_id }}">
                  {{ article.title | escape }}
                </a>
              </h3>

              {% if article.excerpt != blank %}
                <div class="ai-blog-post-card__excerpt-{{ ai_gen_id }}">
                  {{ article.excerpt | strip_html | truncate: block.settings.excerpt_length }}
                </div>
              {% elsif article.content != blank %}
                <div class="ai-blog-post-card__excerpt-{{ ai_gen_id }}">
                  {{ article.content | strip_html | truncate: block.settings.excerpt_length }}
                </div>
              {% endif %}

              <a href="{{ article.url }}" class="ai-blog-post-card__button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-blog-posts__grid-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          <article class="ai-blog-post-card-{{ ai_gen_id }}">
            <div class="ai-blog-post-card__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-blog-post-card__image-placeholder-{{ ai_gen_id }}">
                {{ 'blog-apparel-1' | placeholder_svg_tag }}
              </div>
            </div>

            <div class="ai-blog-post-card__content-{{ ai_gen_id }}">
              {% if block.settings.show_date %}
                <div class="ai-blog-post-card__meta-{{ ai_gen_id }}">
                  {{ 'now' | date: '%B %d, %Y' }}
                </div>
              {% endif %}

              <h3 class="ai-blog-post-card__title-{{ ai_gen_id }}">
                <a href="#" class="ai-blog-post-card__title-link-{{ ai_gen_id }}"> Sample Blog Post Title {{ i }} </a>
              </h3>

              <div class="ai-blog-post-card__excerpt-{{ ai_gen_id }}">
                This is a sample excerpt for blog post {{ i }}. It provides a brief overview of what the article is
                about and entices readers to click through to read more.
              </div>

              <a href="#" class="ai-blog-post-card__button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
              <div class="svg-wrapper">
                {{ 'icon-arrow.svg' | asset_url }}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Latest Blog Posts",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Latest from our blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Read more"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_play_btn",
      "label": "Show Play Button",
      "default": true
    },

    {
      "type": "range",
      "id": "excerpt_length",
      "min": 50,
      "max": 300,
      "step": 10,
      "label": "Excerpt length",
      "default": 150
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "heading_margin",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Heading bottom margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_spacing",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Card spacing",
      "default": 30
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Image height",
      "default": 240
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Section heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Section heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Card title size",
      "default": 20
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "excerpt_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Excerpt size",
      "default": 14
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Date color",
      "default": "#999999"
    },
    {
      "type": "range",
      "id": "meta_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Date size",
      "default": 12
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#000f9f"
    },
    {
      "type": "header",
      "content": "Button Style"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000f9f"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button border radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "button_text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Latest Blog Posts"
    }
  ]
}
{% endschema %}
